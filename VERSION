# The one source of the compiler, language and runtime-ABI versions. Edit
# here and nowhere else.
#
# tools/gen_version_b.sh copies these numbers into src/version.b, which is
# what the compiler itself reads; test/version.sh refuses a stale copy. The
# release packagers read this file to check a release tag matches what the
# tree declares.
#
# This was compiler/version.h, a C++ header, because the stage-0 bootstrap
# was C++ and included it. Nothing compiles it now — every reader parses it —
# so it is a plain file in the format the installed toolchain already ships
# its own VERSION in.
#
# The project is still in the public 1.0 bake, so do not call it 1.0.0 until
# every release gate in ROADMAP.md has passed.
compiler=0.1.35
language=1.0

# 13: display width became a measure the language has. beans_str_width
# answers string.width() in columns, and beans_width_utf8 is the same
# measure over a pointer and a length — the tree interpreter calls it so
# that both compilers read one table. The derived rendering of a Map, a
# Result, a struct and a class instance added beans_show_map_iter, which
# pushes a map's entries onto the iterative show driver's stack, and
# beans_show_enter / beans_show_push_leave, which mark the objects on the
# path so a reference cycle prints <cycle> instead of running forever.
# 12: the contained-panic unwind (issue #44, spec/CONCURRENCY.md). A program
# that brews now emits a fiber-entry cleanup pad that calls
# beans_fiber_unwind_finish to end the fiber once its frames have run their
# defers and dropped what they owned. The runtime gained that entry along with
# beans_fiber_begin_unwind, beans_fiber_unwinding and beans_fiber_message,
# which start the unwind and report it for the double-panic case. Emitted only
# for a program that brews on a target whose unwinder the backend uses; every
# other build keeps the earlier abandon behaviour and links none of it.
# 11: the fiber runtime landed (spec/CONCURRENCY.md) — the beans_fiber_*
# core (spawn, park, yield, resume, cancel, join, worker bootstrap) and the
# brew layer the compiler lowers onto: beans_brew, beans_brew_typed,
# beans_brew_join, beans_brew_value, beans_brew_value_typed,
# beans_brew_message, beans_brew_cancel, beans_brew_scope_join. Channels
# gained the non-blocking twins beans_chan_try_send, beans_chan_try_send_typed,
# beans_chan_try_recv and beans_chan_try_recv_typed.
# Version 10: async/await left the language, and the hidden executor entries
# left the runtime with it — beans_task_slot, beans_set_task_slot and the
# parked-readiness registry (beans_reactor_note_park, beans_reactor_bind_park,
# beans_reactor_forget_park, beans_reactor_stale_park, beans_reactor_park_dead,
# beans_reactor_note_close, beans_reactor_shutdown_parks) are gone.
# Version 9 resolved reflection handles — beans_reflect_method_handle,
# beans_reflect_method_call_handle, beans_reflect_initializer_handle,
# beans_reflect_initializer_call_handle, beans_reflect_function_handle and
# beans_reflect_function_call_handle — so cached descriptors stop
# re-resolving strings on every call.
# Version 8 added the beans_poll_wait_into runtime entry, which fills a
# caller-owned event buffer instead of returning a fresh one.
# Version 7 added Bytes.filled, Bytes.append_int_text, and Thread.detach.
# Version 6 added per-thread runtime-hook guard entry points.
runtime_abi=13
