offer [permessage-deflate; client_no_context_takeover; client_max_window_bits; server_no_context_takeover; server_max_window_bits=9, permessage-deflate; client_no_context_takeover; client_max_window_bits; server_no_context_takeover, permessage-deflate; client_no_context_takeover; client_max_window_bits] -> permessage-deflate; server_no_context_takeover; client_no_context_takeover; server_max_window_bits=9
offer [permessage-deflate; client_max_window_bits] -> permessage-deflate
