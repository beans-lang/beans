offer [permessage-deflate; server_max_window_bits=10; client_max_window_bits=12] -> permessage-deflate; server_max_window_bits=10; client_max_window_bits=12
offer [permessage-deflate; server_max_window_bits=8] -> (declined)
offer [permessage-deflate; client_max_window_bits=8] -> (declined)
